{
  "buildDefinition": {
    "buildType": "https://slsa.dev/container/v1",
    "externalParameters": {
      "source": {
        "uri": "git+https://github.com/jfrog/apptrust-sample",
        "digest": {
          "gitCommit": "REPLACE_WITH_GIT_SHA"
        }
      },
      "workflow": {
        "ref": "refs/heads/main",
        "repository": "jfrog/apptrust-sample",
        "path": ".github/workflows/apptrust-pipeline.yml"
      }
    },
    "internalParameters": {
      "runnerEnvironment": "github-hosted"
    },
